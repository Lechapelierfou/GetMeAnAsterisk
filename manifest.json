{
  "manifest_version": 3,
  "name": "GetMeAnAsterisk",
  "version": "0.1",

  "description": "Save pages to topic lists and keep track of your finds.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "GetMeAnAsterisk@lechapelierfou",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "clipboardWrite", "storage", "tabs"],
  "action": {
    "default_title": "Seite zu einer Liste hinzufügen",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_title": "GetMeAn* – Recherchewerkzeug",
    "default_icon": "icons/icon.svg",
    "default_panel": "popup.html"
  }
}