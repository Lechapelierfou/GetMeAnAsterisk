{
  "manifest_version": 3,
  "name": "GetMeAnAsterisk",
  "version": "0.1",

  "description": "Save pages to topic lists and keep track of your finds.",

  "browser_specific_settings": {
    "gecko": {
      "id": "borderify@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "storage", "tabs"],
  "action": {
    "default_title": "Seite zu einer Liste hinzufügen",
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_title": "GetMeAn* – Recherchen",
    "default_panel": "popup.html"
  }
}